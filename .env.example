# Supabase Auth (Project Settings > API)
# This public value is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Supabase PostgreSQL (Project Settings > Database > Connect)
# Runtime application traffic: use the transaction pooler URL (port 6543) with
# `pgbouncer=true` and `sslmode=no-verify` (`require` does not relax cert
# verification in the pg driver; `no-verify` does — TLS still encrypts).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify

# Prisma CLI migrations and introspection: use the session-mode pooler URL
# (port 5432), with `sslmode=no-verify`. Newer Supabase projects no longer
# expose an IPv4-reachable direct DB host; the pooler works for CLI and app
# traffic. Do not expose either database URL to the browser.
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=no-verify

# OAuth providers (Google, Apple) are configured entirely in the Supabase
# dashboard → Authentication → Providers. No provider client secrets, IDs, or
# redirect URIs live in this file or in application code. The application only
# needs the Supabase URL and publishable key above.
